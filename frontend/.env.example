# Copy to .env.local for local dev. Leave unset for same-origin local
# dev -- vite.config.ts's dev-server proxy already forwards /api/... to
# the backend on :8123, which is what an empty VITE_API_BASE_URL falls
# back to (see src/api.ts). Only needed for a real split-origin deploy
# (DEPLOY.md), where it must be the backend's real absolute origin, no
# trailing slash, baked into the build at build time.
VITE_API_BASE_URL=
