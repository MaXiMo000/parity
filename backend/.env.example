# Copy to .env (or export these directly) for local dev. See
# AUTH_SETUP.md for how to get real GitHub OAuth values and DEPLOY.md
# for production. None of these have safe defaults in production --
# app/main.py fails at boot, not on first request, if one required for
# PARITY_ENV=production is missing.

# Postgres connection string. The default below matches backend/docker-compose.yml.
DATABASE_URL=postgresql+psycopg://parity:parity@127.0.0.1:5441/parity

# "development" (default) or "production" -- see app/main.py's own
# comment for exactly what this flips (session cookie SameSite/Secure,
# and whether a missing var below is a boot-time failure).
PARITY_ENV=development

# Signs the session cookie. Has an insecure dev-only default when unset
# in development; required with no default when PARITY_ENV=production.
# Generate a real one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SESSION_SECRET_KEY=dev-only-insecure-secret-change-before-any-real-deploy

# Fernet key encrypting stored per-workspace credentials at rest.
# Required at boot in every environment, dev included -- there is no
# default. Rotating it permanently locks out every credential already
# stored under the old key (SPEC.md §12). Generate with:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=

# GitHub OAuth App credentials (AUTH_SETUP.md). The literal "dev" values
# below let the app boot and every non-auth route work, but a real GitHub
# login needs a real registered app.
GITHUB_CLIENT_ID=dev
GITHUB_CLIENT_SECRET=dev
GITHUB_CALLBACK_URL=http://localhost:8123/api/auth/github/callback

# The frontend's real origin, for CORS (must match exactly -- scheme,
# host, no trailing slash).
FRONTEND_ORIGIN=http://localhost:5173
